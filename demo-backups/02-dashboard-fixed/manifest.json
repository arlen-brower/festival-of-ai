{
  "manifest_version": 3,
  "name": "My New Tab — Fixed",
  "version": "1.1.0",
  "description": "A personal new-tab dashboard with blank-task validation fixed.",
  "browser_specific_settings": {
    "gecko": {
      "id": "dashboard-fixed@festival-of-ai.local"
    }
  },
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "dashboard.html"
  }
}
