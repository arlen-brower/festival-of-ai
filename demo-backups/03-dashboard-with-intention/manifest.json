{
  "manifest_version": 3,
  "name": "My New Tab — With Intention",
  "version": "1.2.0",
  "description": "A personal new-tab dashboard with a locally saved daily intention.",
  "browser_specific_settings": {
    "gecko": {
      "id": "dashboard-intention@festival-of-ai.local"
    }
  },
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "dashboard.html"
  }
}
